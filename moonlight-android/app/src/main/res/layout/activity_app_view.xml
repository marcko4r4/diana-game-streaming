<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".AppView">

    <!-- Modern App List Header -->
    <RelativeLayout
        android:id="@+id/appTopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/appListText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:textColor="@color/textPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true"
            android:preferKeepClear="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/appListText"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:text="@string/pcview_menu_app_list"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

    </RelativeLayout>

    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/appTopBar"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center">
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/profilesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        android:text="@string/profile_manager_choose_profile"
        android:textColor="@color/onPrimary"
        app:icon="@drawable/ic_profiles"
        app:iconTint="@color/onPrimary"
        app:backgroundTint="@color/primary"
        app:cornerRadius="16dp"
        app:elevation="6dp"
        android:contentDescription="@string/profile_manager_choose_profile" />

</RelativeLayout>
